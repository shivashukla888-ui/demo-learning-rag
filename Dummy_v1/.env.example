DATABASE_NAME=surveillance
DATABASE_USER=surveillance
DATABASE_PASSWORD=change-me
AEGIS_API_KEY=change-me
AEGIS_ACTOR_ID=demo-investigator
AEGIS_ACTOR_ROLE=SUPERVISOR

# Optional server-side, guarded OpenAI investigation copilot.
# Keep LLM_ENABLED=false until a Platform API key and approved model are supplied.
# Never expose this key through NEXT_PUBLIC_* or commit a populated .env file.
LLM_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
LLM_PROMPT_VERSION=investigation-copilot-v1
LLM_MIN_PRIORITY=70
LLM_MIN_EVIDENCE_COVERAGE=0.75
LLM_MIN_MODEL_DISAGREEMENT=0.35
LLM_MAX_INPUT_TOKENS=1800
LLM_MAX_OUTPUT_TOKENS=450
LLM_SUMMARY_MAX_OUTPUT_TOKENS=220
# Runtime cache contains sanitised generated results only and remains Git ignored.
LLM_CACHE_ROOT=/data/llm-cache
LLM_PLAYBOOK_PATH=/app/config/typology-playbooks.json

# Region-aware daily batch intake and bounded Parquet processing.
SURVEILLANCE_ALLOWED_REGIONS=AMER,EMEA,APAC,GLOBAL
SURVEILLANCE_MAX_ALERT_BYTES=536870912
SURVEILLANCE_MAX_PARQUET_BYTES=21474836480
SURVEILLANCE_MAX_REQUEST_SIZE=100GB
DAILY_ALLOWED_REGIONS=AMER,EMEA,APAC,GLOBAL
DAILY_SCAN_SECONDS=5
DAILY_BATCH_WORKERS=2
PARQUET_BATCH_ROWS=100000
DAILY_MAX_ALERTS=500000
DAILY_MAX_CONTEXT_PER_ALERT=5000
DAILY_RULE_WEIGHT=0.30
DAILY_SUPERVISED_WEIGHT=0.55
DAILY_ANOMALY_WEIGHT=0.15
